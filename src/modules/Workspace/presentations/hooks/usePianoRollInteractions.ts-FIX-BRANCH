            if (e.key === ' ' && e.ctrlKey) {
                const state = stepRecordStore.value;
                if (state) {
                    stepRecordNoteOn(state.currentPitch);
                    stepRecordNoteOff(state.currentPitch);
                }
            } else if (e.key === 'Enter') {
                stepRecordAdvance();
            } else if (e.key === 'Backspace') {
                stepRecordBack();
            }
