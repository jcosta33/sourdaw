#!/usr/bin/env bash
# Answers `apt-config shell` for the two source locations, as apt resolves
# them: from FAKE_APT_SOURCE_LIST and FAKE_APT_SOURCE_PARTS, or from the file
# APT_CONFIG names unless FAKE_APT_IGNORES_APT_CONFIG=true stands in for a
# later apt.conf.d entry that overrides it.
set -euo pipefail
[ "${1:-}" = shell ] || { printf 'apt-config stub answers only shell\n' >&2; exit 64; }
shift
list=$FAKE_APT_SOURCE_LIST
parts=$FAKE_APT_SOURCE_PARTS
if [ -n "${APT_CONFIG:-}" ] && [ "${FAKE_APT_IGNORES_APT_CONFIG:-false}" != true ]; then
  list=$(sed -n 's/^Dir::Etc::sourcelist "\(.*\)";$/\1/p' "$APT_CONFIG")
  parts=$(sed -n 's/^Dir::Etc::sourceparts "\(.*\)";$/\1/p' "$APT_CONFIG")
fi
while [ "$#" -ge 2 ]; do
  case "$2" in
    Dir::Etc::sourcelist/f) printf "%s='%s'\n" "$1" "$list" ;;
    Dir::Etc::sourceparts/d) printf "%s='%s/'\n" "$1" "${parts%/}" ;;
    *) printf 'apt-config stub has no value for %s\n' "$2" >&2; exit 64 ;;
  esac
  shift 2
done
