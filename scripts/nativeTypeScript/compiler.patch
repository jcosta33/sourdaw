@@ -5202,8 +5202,61 @@ describe("Timing", () => {
     });
 });
 
+describe("Checker - getAwaitedType", () => {
+    test("uses native Promise, thenable, union and recursive semantics", async () => {
+        const api = spawnAPI({
+            "/tsconfig.json": JSON.stringify({ compilerOptions: { strict: true, target: "esnext" } }),
+            "/src/awaited.ts": `
+export type PromiseVoid = Promise<void>;
+export type PromiseUndefined = Promise<undefined>;
+export type Nested = Promise<Promise<number | undefined>>;
+export type AnyResult = Promise<any>;
+export type UnknownResult = Promise<unknown>;
+export type NeverResult = Promise<never>;
+export type ThenVoid = { then(callback: (value: void) => unknown): unknown };
+export type ThenNumber = { then(callback: (value: number) => unknown): unknown };
+export type Cycle = { then(callback: (value: Cycle) => unknown): unknown };
+`,
+        });
+        try {
+            const snapshot = await api.updateSnapshot({ openProjects: ["/tsconfig.json"] });
+            try {
+                const project = snapshot.getProject("/tsconfig.json");
+                assert.ok(project);
+                const source = await project.program.getSourceFile("/src/awaited.ts");
+                assert.ok(source);
+                const results = new Map<string, string | undefined>();
+                for (const declaration of source.statements) {
+                    assert.ok(isTypeAliasDeclaration(declaration));
+                    const input = await project.checker.getTypeFromTypeNode(declaration.type);
+                    assert.ok(input);
+                    const result = await project.checker.getAwaitedType(input);
+                    assert.equal(await project.checker.getAwaitedType(input), result, "returned types must retain native registry identity");
+                    results.set(declaration.name.text, result ? await project.checker.typeToString(result) : undefined);
+                }
+                assert.equal(results.get("PromiseVoid"), "void");
+                assert.equal(results.get("PromiseUndefined"), "undefined");
+                assert.equal(results.get("Nested"), "number | undefined");
+                assert.equal(results.get("AnyResult"), "any");
+                assert.equal(results.get("UnknownResult"), "unknown");
+                assert.equal(results.get("NeverResult"), "never");
+                assert.equal(results.get("ThenVoid"), "void");
+                assert.equal(results.get("ThenNumber"), "number");
+                assert.equal(results.get("Cycle"), undefined);
+            }
+            finally {
+                await snapshot.dispose();
+            }
+        }
+        finally {
+            await api.close();
+        }
+    });
+});
+
 function spawnAPI(files: Record<string, string> = { ...defaultFiles }) {
     return new API({
+        tsserverPath: process.env.SOURDAW_NATIVE_TS_TEST_COMPILER,
         cwd: fileURLToPath(new URL("../../../../", import.meta.url).toString()),
         fs: createVirtualFileSystem(files),
     });
