.DS_Store
node_modules
dist/
coverage/

# Compiled Electron main process (`pnpm desktop:dev` output)
electron/out/

# Packaged desktop artifacts (`pnpm desktop:build` output). `release/` itself is
# tracked — it holds the open-source inventory.
release/desktop/

.env
.env.*
!.env.example

# Rust
target/

# Editor
.vscode/
*.sw?

# Agent worktrees
.agents/worktrees/

# Review bundles produced by `pnpm review:prepare`
.agents/review-bundles/

# Agent campaign artifacts live in the global workspace (~/.agents/artifacts/<project>/),
# never in the repo. Promotion to repo-owned docs happens deliberately via the promote flow.
.agents/artifacts/

# Playwright
playwright-report/
test-results/

# Generated agent UI screenshots
.agents/ui-scripts/*.png

# Local command captures
/*.out
/cw.txt
/fmt-files.txt

# Native addon build artifact (produced by scripts/buildNativeAddon.ts)
/crates/sourdaw-native/*.node
/crates/sourdaw-native/*.dylib
