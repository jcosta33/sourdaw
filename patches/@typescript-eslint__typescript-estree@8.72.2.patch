+import type { Checker, NodeHandle, Project, Signature, Symbol, Type } from 'typescript/unstable/sync';
+import type { Node } from 'typescript/unstable/ast';
+import type { TSESTree } from '@typescript-eslint/types';
+export type NativeParserServicesWithTypeInformation = {
+    hasTypeInformation: true;
