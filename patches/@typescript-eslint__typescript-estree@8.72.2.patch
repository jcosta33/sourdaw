+'use strict';
+const ast = require('typescript/unstable/ast');
+function nativeModuleKind(node) {
+    const source = node.getSourceFile();
+    let token = ast.getTokenAtPosition(source, node.getStart(source));
+    while (token.kind === ast.SyntaxKind.DeclareKeyword || token.kind === ast.SyntaxKind.ExportKeyword || token.kind === ast.SyntaxKind.DefaultKeyword) {
+        token = ast.findNextToken(token, node, source);
+        if (!token) throw new Error('Native module declaration has no declaration keyword');
+    }
+    if (token.kind === ast.SyntaxKind.NamespaceKeyword) return 'namespace';
+    if (token.kind === ast.SyntaxKind.ModuleKeyword) return 'module';
+    if (ast.isIdentifier(node.name) && token === node.name && node.name.text === 'global') return 'global';
+    throw new Error('Native module declaration keyword could not be identified');
+}
+exports.nativeModuleKind = nativeModuleKind;
