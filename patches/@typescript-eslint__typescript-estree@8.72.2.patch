+    tsNodeToESTreeNodeMap: WeakMap<Node, TSESTree.Node>;
+    emitDecoratorMetadata: boolean;
+    experimentalDecorators: boolean;
+    isolatedDeclarations: boolean;
+    getTypeAtLocation(node: TSESTree.Node): Type;
+    getSymbolAtLocation(node: TSESTree.Node): Symbol | undefined;
+    getContextualType(node: TSESTree.Node): Type | undefined;
+    getResolvedSignature(node: TSESTree.Node): Signature | undefined;
+    getTypeFromTypeNode(node: TSESTree.Node): Type;
+    getTypeOfSymbolAtLocation(symbol: Symbol, node: TSESTree.Node): Type;
+    resolveNodeHandle(handle: NodeHandle): Node;
+    readonly whenDisposed: Promise<void>;
+    dispose(): void;
