+    isolatedDeclarations?: boolean;
+    esTreeNodeToTSNodeMap: WeakMap<TSESTree.Node, Node>;
+    tsNodeToESTreeNodeMap: WeakMap<Node, TSESTree.Node>;
+};
+export type NativeParserServices = NativeParserServicesWithTypeInformation | NativeParserServicesWithoutTypeInformation;
