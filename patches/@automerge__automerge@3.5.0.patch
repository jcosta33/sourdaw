+/**
+ * Parse a complete document with checked native loading, without materializing its JS value.
+ * The caller may yield between preparation and materialization. Until materialize succeeds,
+ * the caller owns the pending load and must discard it when it is no longer needed.
+ * A successful materialize transfers ownership to the returned document; discard is then a no-op.
+ */
+export declare function prepareLoad<T>(data: Uint8Array, options?: ActorId | Pick<InitOptions<T>, "actor" | "freeze">): {
+    materialize(): Doc<T>;
