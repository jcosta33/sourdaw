+"use strict";
+Object.defineProperty(exports, "__esModule", { value: true });
+exports.loadBuildYaml = loadBuildYaml;
+const yaml = require("js-yaml");
+
+// Keep the build configuration's accepted YAML values explicit when upgrading
+// the parser. Parsing and validation remain in the published js-yaml engine.
+const integerTag = yaml.defineScalarTag(yaml.intCoreTag.tagName, {
+    ...yaml.intCoreTag,
+    resolve(source, isExplicit, tagName) {
+        const value = yaml.intCoreTag.resolve(source, true, tagName);
+        return Object.is(value, -0) ? 0 : value;
+    },
+});
+const floatTag = yaml.defineScalarTag(yaml.floatCoreTag.tagName, {
+    ...yaml.floatCoreTag,
+    resolve(source, isExplicit, tagName) {
+        if (/^[+-]\.[0-9]/.test(source)) {
+            return yaml.NOT_RESOLVED;
+        }
+        return yaml.floatCoreTag.resolve(source, isExplicit, tagName);
+    },
+});
+const setTag = yaml.defineMappingTag(yaml.setTag.tagName, {
+    ...yaml.legacyMapTag,
+    identify: () => false,
+    addPair(container, key, value) {
+        if (value !== null) {
+            return "set entries must have null values";
+        }
+        return yaml.legacyMapTag.addPair(container, key, value);
+    },
+});
+const buildCoreSchema = yaml.CORE_SCHEMA.withTags(integerTag, floatTag, yaml.legacyMapTag);
+exports.buildCoreSchema = buildCoreSchema;
+const buildConfigSchema = buildCoreSchema.withTags(
+    yaml.mergeTag, yaml.timestampTag, yaml.binaryTag, yaml.omapTag, yaml.pairsTag, setTag,
+);
+
+function loadBuildYaml(input, options = {}) {
+    const documents = yaml.loadAll(input, { schema: buildConfigSchema, ...options });
+    if (documents.length > 1) {
+        throw new yaml.YAMLException("expected a single document in the stream, but found more");
+    }
+    return documents.length === 0 ? (/^[ \n\uFEFF]*$/.test(input) ? undefined : null) : documents[0];
+}
