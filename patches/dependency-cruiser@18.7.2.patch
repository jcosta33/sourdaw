diff --git a/src/extract/tsc/native-session.mjs b/src/extract/tsc/native-session.mjs
new file mode 100644
--- /dev/null
+++ b/src/extract/tsc/native-session.mjs
@@ -0,0 +1,54 @@
+import { randomUUID } from 'node:crypto';
+import { resolve } from 'node:path';
+import { API, DiagnosticCategory } from 'typescript/unstable/sync';
+import { createVirtualFileSystem } from 'typescript/unstable/fs';
+
+let active;
+
+/** Extraction is synchronous: one native project owns every source requested during this operation. */
+export function withNativeSyntaxSession(operation) {
+    const previous = active;
+    const config = resolve(process.cwd(), `.native-cruise-${randomUUID()}.json`);
+    const virtual = createVirtualFileSystem({ [config]: '{}' });
+    let api;
+    let snapshot;
+    let current;
+    active = (fileName, source) => {
+        api ??= new API({ fs: virtual });
+        snapshot?.dispose();
+        if (current && current !== fileName) virtual.removeFile(current);
+        virtual.writeFile(fileName, source);
+        virtual.writeFile(config, JSON.stringify({
+            compilerOptions: {
+                allowJs: true, noLib: true, noResolve: true, noCheck: true, noEmit: true,
+                jsx: 'preserve', target: 'esnext', module: 'esnext', types: [],
+            },
+            files: [fileName],
+        }));
+        snapshot = api.updateSnapshot({
+            openProjects: current ? undefined : [config],
+            fileChanges: { changed: [config, ...(current === fileName ? [fileName] : [])], created: current !== fileName ? [fileName] : [], deleted: current && current !== fileName ? [current] : [] },
+        });
+        current = fileName;
+        const project = snapshot.getProject(config);
+        const file = project?.program.getSourceFile(fileName);
+        if (!file || file.text !== source) throw new Error(`Native cruise parser omitted input: ${fileName}`);
+        const errors = [
+            ...project.program.getConfigFileParsingDiagnostics(),
+            ...project.program.getProgramDiagnostics(),
+            ...project.program.getSyntacticDiagnostics(fileName),
+        ].filter((item) => item.category === DiagnosticCategory.Error);
+        if (errors.length) throw new Error(errors.map((item) => `${fileName}: ${item.text}`).join('\n'));
+        return file;
+    };
+    try { return operation(); }
+    finally {
+        active = previous;
+        try { snapshot?.dispose(); } finally { api?.close(); }
+    }
+}
+
+export function parseNativeSource(fileName, source) {
+    const file = resolve(fileName);
+    return active ? active(file, source) : withNativeSyntaxSession(() => active(file, source));
+}
