--- /dev/null
+++ b/lib/ours/abort.js
@@ -0,0 +1,9 @@
+'use strict'
+
+const { AbortController, AbortSignal } = globalThis
+
+if (typeof AbortController !== 'function' || typeof AbortSignal !== 'function') {
+  throw new Error('readable-stream requires native AbortController and AbortSignal in Node.js 26 or supported Chromium')
+}
+
+module.exports = { AbortController, AbortSignal }
