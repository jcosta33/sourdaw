diff --git a/lib/shared/prepare-rule-schema.js b/lib/shared/prepare-rule-schema.js
new file mode 100644
index 0000000..be0152d
--- /dev/null
+++ b/lib/shared/prepare-rule-schema.js
@@ -0,0 +1,41 @@
+"use strict";
+const traverse = require("json-schema-traverse");
+const builtInAnnotations = new Set(["$schema", "id", "$defs", "definitions", "title", "description", "default"]);
+
+function enumerableCopy(value) {
+    const entries = [];
+    for (const key in value) entries.push([key, value[key]]);
+    return Object.fromEntries(entries);
+}
+
+/** Normalize schema identifiers, never instance/default/enum data, for the draft-04 compiler. */
+module.exports = (ajv, schema) => {
+    if (typeof schema === "boolean") return schema;
+    const copies = new Map();
+    let root;
+    traverse(schema, { allKeys: true }, (node, _pointer, _root, _parentPointer, keyword, parent, index) => {
+        const copy = enumerableCopy(node);
+        copies.set(node, copy);
+        if (!parent) root = copy;
+        else {
+            const parentCopy = copies.get(parent);
+            if (index === undefined) parentCopy[keyword] = copy;
+            else {
+                if (parentCopy[keyword] === parent[keyword]) {
+                    parentCopy[keyword] = Array.isArray(parent[keyword]) ? [...parent[keyword]] : enumerableCopy(parent[keyword]);
+                }
+                Object.defineProperty(parentCopy[keyword], index, { value: copy, writable: true, enumerable: true, configurable: true });
+            }
+        }
+        if (node.$id !== undefined) {
+            if (node.id !== undefined && node.id !== node.$id) throw new Error("schema $id is different from id");
+            copy.id = node.$id;
+            delete copy.$id;
+        }
+        // Draft-04 permits extension annotations. Known keywords keep the compiler's real validation.
+        for (const key in copy) {
+            if (!builtInAnnotations.has(key) && !ajv.getKeyword(key)) ajv.addKeyword({ keyword: key });
+        }
+    });
+    return root;
+};
diff --git a/lib/shared/schema-error-path.js b/lib/shared/schema-error-path.js
new file mode 100644
index 0000000..694669b
--- /dev/null
+++ b/lib/shared/schema-error-path.js
@@ -0,0 +1,16 @@
+"use strict";
+
+/** Format native JSON Pointer errors against the schema value, retaining readable array/property paths. */
+module.exports = (pointer, schema) => {
+    let current = schema;
+    let result = "";
+    if (!pointer) return result;
+    for (const encoded of pointer.slice(1).split("/")) {
+        const key = encoded.replace(/~1/g, "/").replace(/~0/g, "~");
+        if (Array.isArray(current) && /^(?:0|[1-9][0-9]*)$/.test(key)) result += `[${key}]`;
+        else if (/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(key)) result += `${result ? "." : ""}${key}`;
+        else result += `[${JSON.stringify(key)}]`;
+        current = current?.[key];
+    }
+    return result;
+};
