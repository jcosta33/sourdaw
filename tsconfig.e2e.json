{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "@playwright/test", "vite/client"],
        "allowImportingTsExtensions": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noUncheckedIndexedAccess": false,
        "paths": {
            "#/*": ["./src/*"],
            "/src/*": ["./src/*"],
            "virtual:sourdaw-basic-pitch-model": ["./src/modules/AudioAnalysis/repositories/basicPitchModel.d.ts"]
        }
    },
    "include": ["playwright.config.ts", "src/types/**/*.d.ts", "tests/e2e/**/*.ts", "tests/production-e2e/**/*.ts"]
}
