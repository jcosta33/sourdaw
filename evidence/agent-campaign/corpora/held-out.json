        {
            "id": "AC054-HO-EXEC-1",
            "class": "execute-exact",
            "prompt": "create a walking bass line on a new track",
            "providerTurns": [
                { "kind": "search", "intents": ["create a midi track", "add a clip", "add midi notes"] },
                { "kind": "discover", "names": ["addTrack", "addClip", "addNotes"] },
                {
                    "kind": "propose",
                    "items": [
                        {
                            "id": "make-track",
                            "name": "addTrack",
                            "arguments": { "name": "Bass", "kind": "midi", "binding": "bass" }
                        },
                        {
                            "id": "make-clip",
                            "name": "addClip",
                            "arguments": {
                                "trackId": "$bass",
                                "startBeat": 0,
                                "endBeat": 8,
                                "name": "Walking Bass",
                                "binding": "bassclip"
                            },
                            "dependsOn": ["make-track"]
                        },
                        {
                            "id": "write-notes",
                            "name": "addNotes",
                            "arguments": {
                                "clipId": "$bassclip",
                                "notes": [
                                    { "pitch": 40, "startBeat": 0, "duration": 1, "velocity": 100 },
                                    { "pitch": 43, "startBeat": 1, "duration": 1, "velocity": 100 }
                                ]
                            },
                            "dependsOn": ["make-clip"]
                        }
                    ]
                }
            ],
            "oracle": { "kind": "proposal", "actionTypes": ["addTrack", "addClip", "addNotes"] }
        },
        {
