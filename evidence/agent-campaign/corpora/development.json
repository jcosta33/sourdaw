                            "arguments": {
                                "trackId": "$comp",
                                "startBeat": 0,
                                "endBeat": 12,
                                "name": "Twelve Bar",
                                "binding": "chorus"
                            },
                            "dependsOn": ["make-track"]
                        },
                        {
                            "id": "write-notes",
                            "name": "addNotes",
                            "arguments": {
                                "clipId": "$chorus",
                                "notes": [
                                    { "pitch": 60, "startBeat": 0, "duration": 1, "velocity": 96 },
                                    { "pitch": 64, "startBeat": 0, "duration": 1, "velocity": 96 },
                                    { "pitch": 67, "startBeat": 0, "duration": 1, "velocity": 96 }
                                ]
                            },
                            "dependsOn": ["make-clip"]
                        },
                        { "id": "set-tempo", "name": "setTempo", "arguments": { "bpm": 96 } }
                    ]
                }
            ],
            "oracle": { "kind": "proposal", "actionTypes": ["addTrack", "addClip", "addNotes", "setTempo"] }
        },
