                {
                    "kind": "propose",
                    "items": [
                        {
                            "id": "make-track",
                            "name": "addTrack",
                            "arguments": { "name": "Blues Comp", "kind": "midi", "binding": "comp" }
                        },
                        {
                            "id": "make-clip",
