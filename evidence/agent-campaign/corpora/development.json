{
    "schemaVersion": 1,
    "corpus": "development",
    "cases": [
        {
            "id": "AC054-DEV-EXEC-1",
            "class": "execute-exact",
            "prompt": "create a blues song with a twelve bar progression",
            "providerTurns": [
                { "kind": "search", "intents": ["create a midi track", "add a clip", "add midi notes"] },
                { "kind": "discover", "names": ["addTrack", "addClip", "addNotes"] },
                {
                    "kind": "propose",
                    "items": [
                        {
                            "id": "make-track",
                            "name": "addTrack",
                            "arguments": { "name": "Blues Comp", "kind": "midi", "binding": "comp" }
                        },
                        {
                            "id": "make-clip",
                            "name": "addClip",
                            "arguments": {
                                "trackId": "$comp",
                                "startBeat": 0,
                                "endBeat": 12,
                                "name": "Twelve Bar",
                                "binding": "chorus"
                            },
                            "dependsOn": ["make-track"]
                        },
                        {
                            "id": "write-notes",
                            "name": "addNotes",
                            "arguments": {
                                "clipId": "$chorus",
                                "notes": [
                                    { "pitch": 60, "startBeat": 0, "duration": 1, "velocity": 96 },
                                    { "pitch": 64, "startBeat": 0, "duration": 1, "velocity": 96 },
                                    { "pitch": 67, "startBeat": 0, "duration": 1, "velocity": 96 }
                                ]
                            },
                            "dependsOn": ["make-clip"]
                        }
                    ]
                }
            ],
            "oracle": { "kind": "proposal", "actionTypes": ["addTrack", "addClip", "addNotes"] }
        },
        {
            "id": "AC054-DEV-EXEC-2",
