{
    "name": "sourdaw",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:no-hmr": "NO_HMR=1 vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:generate-usecase-specs": "node scripts/generate-missing-use-case-specs.mjs",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsgo --noEmit",
        "codemod": "jscodeshift",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\" && cargo fmt --all",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
        "deps:validate": "depcruise src",
        "tauri:dev": "tauri dev",
        "tauri:build": "RUSTFLAGS='-Cembed-bitcode=no -Zpacked-bundled-libs=no' tauri build",
        "wasm:dsp": "cd crates/daw-dsp && wasm-pack build --target web --out-dir ../../public/wasm/daw-dsp --no-typescript && rm -f ../../public/wasm/daw-dsp/.gitignore && node ../../scripts/gen-daw-dsp-worklet.mjs",
        "wasm:proof-chamber": "cd crates/proof-chamber && wasm-pack build --target web --out-dir ../../public/wasm/proof-chamber --no-typescript && rm -f ../../public/wasm/proof-chamber/.gitignore && node ../../scripts/gen-proof-chamber-worklet.mjs",
        "wasm:scoring": "cd crates/scoring && wasm-pack build --target web --out-dir ../../public/wasm/scoring --no-typescript && rm -f ../../public/wasm/scoring/.gitignore && node ../../scripts/gen-scoring-worklet.mjs",
        "wasm:decoder": "cd crates/daw-wasm-decoder && wasm-pack build --target web --out-dir ../../public/wasm/daw-wasm-decoder --no-typescript && rm -f ../../public/wasm/daw-wasm-decoder/.gitignore",
        "wasm:all": "npm run wasm:dsp && npm run wasm:proof-chamber && npm run wasm:scoring && npm run wasm:decoder",
        "agents": "node ./scripts/agents.mjs",
        "agents:new": "node ./scripts/agents.mjs new",
        "agents:new:claude": "node ./scripts/agents.mjs new claude",
        "agents:new:gemini": "node ./scripts/agents.mjs new gemini",
        "agents:new:codex": "node ./scripts/agents.mjs new codex",
        "agents:open": "node ./scripts/agents.mjs open",
        "agents:open:claude": "node ./scripts/agents.mjs open claude",
        "agents:open:gemini": "node ./scripts/agents.mjs open gemini",
        "agents:open:codex": "node ./scripts/agents.mjs open codex",
        "agents:list": "node ./scripts/agents.mjs list",
        "agents:show": "node ./scripts/agents.mjs show",
        "agents:task": "node ./scripts/agents.mjs task",
        "agents:remove": "node ./scripts/agents.mjs remove",
        "agents:prune": "node ./scripts/agents.mjs prune",
        "agents:doctor": "node ./scripts/agents.mjs doctor",
        "agents:path": "node ./scripts/agents.mjs path",
        "agents:focus": "node ./scripts/agents.mjs focus",
        "agents:pick": "node ./scripts/agents.mjs pick"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.81.0",
        "@automerge/automerge": "^3.2.5",
        "@breezystack/lamejs": "^1.2.7",
        "@grame/faustwasm": "^0.16.1",
        "@huggingface/transformers": "^4.0.1",
        "@mlc-ai/web-llm": "^0.2.82",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@spotify/basic-pitch": "^1.0.1",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/eslint-plugin-query": "^5.96.2",
        "@tanstack/react-query": "^5.96.2",
        "@tanstack/react-router": "^1.168.10",
        "@tauri-apps/api": "^2.10.1",
        "@tauri-apps/plugin-dialog": "^2.7.0",
        "@tauri-apps/plugin-fs": "^2.5.0",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint-plugin-import": "^2.32.0",
        "fflate": "^0.8.2",
        "lucide-react": "^1.7.0",
        "meyda": "^5.6.3",
        "onnxruntime-web": "^1.24.3",
        "pitchy": "^4.1.0",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "superjson": "^2.2.6",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
        "@eslint-react/eslint-plugin": "^4.2.3",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tanstack/router-plugin": "^1.167.12",
        "@tauri-apps/cli": "^2.10.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jscodeshift": "^17.3.0",
        "@types/node": "^25.5.2",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/sinon": "^21.0.1",
        "@typescript/native-preview": "7.0.0-dev.20260408.1",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.3",
        "@webgpu/types": "^0.1.69",
        "babel-plugin-react-compiler": "^1.0.0",
        "dependency-cruiser": "^17.3.10",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y-x": "^0.1.1",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.4.0",
        "jscodeshift": "^17.3.0",
        "jsdom": "^29.0.2",
        "knip": "^6.3.1",
        "sinon": "^21.0.3",
        "ts-morph": "^27.0.2",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vite": "^8.0.7",
        "vitest": "^4.1.3"
    }
}
