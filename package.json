{
    "name": "sourdaw",
    "private": true,
    "version": "0.1.0",
    "license": "Apache-2.0",
    "type": "module",
    "main": "electron/out/main.js",
    "packageManager": "pnpm@12.20.0",
    "engines": {
        "node": ">=26.13.1 <27"
    },
    "scripts": {
        "dev": "vite",
        "guard": "node scripts/resourceGuard.ts",
        "guard:recover": "node scripts/resourceGuard.ts --recover",
        "dev:no-hmr": "NO_HMR=1 vite",
        "build": "vite build",
        "preview": "vite preview",
        "test:watch": "vitest",
        "test:health-gates": "pnpm test:run scripts/__tests__/healthGatesWorkflow.spec.ts && sh scripts/test-health-gate-scripts.sh",
        "test:health-gates:record": "node scripts/recordHealthGateWorkflowSnapshot.ts",
        "harness:plugin:install": "node scripts/installHarnessPlugin.ts",
        "health:rust": "sh scripts/health-gates-rust.sh",
        "health:server": "sh scripts/health-gates-server.sh",
        "health:server:full": "sh scripts/health-gates-rust.sh && sh scripts/health-gates-server.sh",
        "test:run": "node scripts/runVitestZeroTestGuard.ts",
        "test:collection-scope": "node scripts/checkVitestCollectionScope.ts",
        "test:command-schema": "node scripts/generateVersionedCommandArgumentSchemas.mjs --check",
        "test:release-inventory": "node scripts/checkReleaseInventory.ts",
        "test:project-license": "node scripts/checkProjectLicense.ts",
        "license:dependencies": "node scripts/generateDependencyLicenseReport.ts",
        "test:electron-runtime": "node scripts/checkElectronRuntimeProvenance.ts",
        "test:electron-runtime:online": "node scripts/checkElectronRuntimeProvenance.ts --online",
        "release:restamp": "node scripts/restampDependencyBump.ts",
        "release:restamp:wasm": "node scripts/restampWasmInventory.ts",
        "release:restamp:tracked-set": "node scripts/restampTrackedSetInventory.ts",
        "release:proof": "node scripts/releaseProof.ts check",
        "release:proof:assemble": "node scripts/releaseProof.ts assemble",
        "release:propose": "node scripts/proposeRelease.ts",
        "release:cut": "node scripts/trustedGithubWriteBootstrap.ts release:cut",
        "test:lgpl-runtime": "node scripts/checkLgplRuntimeProvenance.ts",
        "test:lgpl-runtime:online": "node scripts/checkLgplRuntimeProvenance.ts --online",
        "test:barrel-mocks": "node scripts/checkBarrelMockCoverage.ts",
        "census:ui": "node scripts/uiRestatementCensus.ts",
        "test:e2e": "playwright test",
        "test:e2e:browser-ai-webgpu-admission": "playwright test --config tests/e2e/browserAiWebGpuAdmission.playwright.config.ts",
        "deliver": "node scripts/trustedGithubWriteBootstrap.ts deliver",
        "lane:open": "node scripts/openLane.ts",
        "lane:publish": "node scripts/trustedGithubWriteBootstrap.ts lane:publish",
        "lane:sync-parent": "node scripts/trustedGithubWriteBootstrap.ts lane:sync-parent",
        "lane:remove": "node scripts/removeLane.ts",
        "lane:cleanup": "node scripts/cleanupLanesCli.ts",
        "lane:cleanup:install": "node scripts/installCleanupLanes.ts",
        "lane:strand": "node scripts/removeLane.ts --strand",
        "lane:identity": "node scripts/stampLaneIdentity.ts",
        "lane:prune": "node scripts/pruneLane.ts",
        "review:prepare": "node scripts/prepareReviewEntry.ts",
        "review:accept": "node scripts/trustedGithubWriteBootstrap.ts review:accept",
        "review:publish": "node scripts/trustedGithubWriteBootstrap.ts review:publish",
        "review:publish:recover": "node scripts/trustedGithubWriteBootstrap.ts review:publish:recover",
        "review:repair": "node scripts/trustedGithubWriteBootstrap.ts review:repair",
        "review:confirm": "node scripts/trustedGithubWriteBootstrap.ts review:confirm",
        "review:resolve": "node scripts/trustedGithubWriteBootstrap.ts review:resolve",
        "review:shadow-status": "node scripts/trustedGithubWriteBootstrap.ts review:shadow-status",
        "review:reconstruct": "node scripts/reconstructReviewRounds.ts",
        "ruleset:harden": "node scripts/trustedGithubWriteBootstrap.ts ruleset:harden",
        "retarget:plan": "node scripts/retargetCapabilitySnapshot.ts",
        "pr:supersede": "node scripts/trustedGithubWriteBootstrap.ts pr:supersede",
        "pr:retire": "node scripts/trustedGithubWriteBootstrap.ts pr:retire",
        "branch:prune": "node scripts/trustedGithubWriteBootstrap.ts branch:prune",
        "issue:reconcile": "node scripts/trustedGithubWriteBootstrap.ts issue:reconcile",
        "issue:claim": "node scripts/trustedGithubWriteBootstrap.ts issue:claim",
        "issue:file": "node scripts/fileTrackerIssue.ts",
        "audio:deadline": "node scripts/measureRenderDeadline.ts",
        "browser-ai:model-storage": "node scripts/measureBrowserAiModelStorage.ts",
        "desktop:agent-proof": "node scripts/proveDesktopAgentWorkspace.ts",
        "desktop:measure": "node scripts/measureDesktopLatency.ts",
        "transport:clock": "node scripts/measureTransportClock.ts",
        "transport:yeast-drift": "node scripts/measureYeastGeneratorDrift.ts",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.eslint-config.json",
        "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
        "typecheck:electron": "tsc --noEmit -p electron/tsconfig.json",
        "format": "prettier --write --",
        "format:full": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\" && cargo fmt --all",
        "native:typescript:prepare": "node scripts/nativeTypeScript/prepare.mjs",
        "lint": "node scripts/runLint.ts",
        "lint:full": "node scripts/runLint.ts --full",
        "lint:fix": "node scripts/runLint.ts --fix",
        "deps:validate": "node scripts/check-dependency-boundaries.mjs",
        "deps:unused": "pnpm exec knip",
        "deps:unused:production": "pnpm exec knip --production",
        "desktop:dev": "install-electron && NODE_ENV=development vite build && tsc -p electron/tsconfig.dev.json && node scripts/buildElectronPreload.ts && node scripts/buildNativeAddon.ts && SOURDAW_DESKTOP_DEV=1 electron electron/out/main.js 2>&1 | tee electron/out/desktop-dev.log",
        "desktop:build": "install-electron && vite build && rm -rf dist/samples && tsc -p electron/tsconfig.build.json && node scripts/buildElectronPreload.ts && node scripts/buildNativeAddon.ts && electron-builder --config electron-builder.yml --publish never",
        "evidence:gate": "node scripts/agent-campaign/run-evidence-gate.ts",
        "cargo:fmt": "cargo fmt",
        "cargo:test": "cargo test",
        "cargo:check": "cargo check",
        "cargo:clippy": "cargo clippy",
        "cargo:bench": "cargo bench",
        "cargo:fuzz": "cargo fuzz",
        "wasm:dsp": "node scripts/buildWasmPackage.ts daw-dsp",
        "wasm:proof-chamber": "node scripts/buildWasmPackage.ts proof-chamber",
        "wasm:scoring": "node scripts/buildWasmPackage.ts scoring",
        "wasm:decoder": "node scripts/buildWasmPackage.ts daw-wasm-decoder",
        "wasm:all": "pnpm wasm:dsp && pnpm wasm:proof-chamber && pnpm wasm:scoring && pnpm wasm:decoder && pnpm wasm:manifest",
        "wasm:manifest": "node scripts/gen-wasm-manifest.ts",
        "wasm:verify": "node scripts/verify-wasm-artifacts.ts"
    },
    "dependencies": {
        "@automerge/automerge": "^3.5.0",
        "@breezystack/lamejs": "1.2.7",
        "@grame/faustwasm": "0.20.2",
        "@mlc-ai/web-llm": "^0.2.88",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@spotify/basic-pitch": "^1.0.1",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-router": "^1.170.46",
        "@tensorflow/tfjs-backend-webgpu": "4.22.0",
        "@tensorflow/tfjs-converter": "4.22.0",
        "@tensorflow/tfjs-core": "4.22.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fflate": "^0.8.3",
        "lucide-react": "^1.72.0",
        "meyda": "^5.6.3",
        "onnxruntime-web": "^1.31.1",
        "pitchy": "^4.1.0",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "superjson": "^2.2.6",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@ast-grep/cli": "0.51.2",
        "@electron/asar": "4.3.2",
        "@electron/fuses": "^2.1.3",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint-react/eslint-plugin": "^5.30.2",
        "@playwright/test": "^1.65.0",
        "@rolldown/plugin-babel": "^0.3.1",
        "@stylistic/eslint-plugin": "^6.0.0",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/eslint-plugin-query": "^5.107.1",
        "@tanstack/router-plugin": "^1.169.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/spdx-expression-parse": "4.0.0",
        "@typescript-eslint/parser": "8.72.2",
        "@typescript-eslint/utils": "8.72.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "@webgpu/types": "^0.1.74",
        "babel-plugin-react-compiler": "^1.0.0",
        "dependency-cruiser": "^18.7.2",
        "electron": "45.3.2",
        "electron-builder": "^26.18.1",
        "esbuild": "0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "6.2.8",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "knip": "^6.45.1",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "playwright": "^1.65.0",
        "prettier": "^3.10.1",
        "spdx-expression-parse": "5.0.0",
        "supports-color": "^11.0.0",
        "tar": "7.5.23",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "yaml": "2.9.1"
    }
}
