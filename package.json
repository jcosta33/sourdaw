{
    "name": "sourdaw",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "electron/out/main.js",
    "packageManager": "pnpm@11.6.0",
    "engines": {
        "node": ">=22.17.0 <23"
    },
    "scripts": {
        "dev": "vite",
        "dev:no-hmr": "NO_HMR=1 vite",
        "build": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- vite build",
        "preview": "vite preview",
        "test:watch": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- vitest",
        "test:health-gates": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- sh scripts/test-health-gate-scripts.sh",
        "health:web:full": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended -- sh scripts/health-gates-web.sh",
        "health:server:full": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended -- sh scripts/health-gates-server.sh",
        "test:run": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused --require-target -- vitest run",
        "test:full": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- vitest run",
        "test:collection-scope": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- node --experimental-strip-types scripts/checkVitestCollectionScope.ts",
        "test:command-schema": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node scripts/generateVersionedCommandArgumentSchemas.mjs --check",
        "test:release-inventory": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/checkReleaseInventory.ts",
        "test:barrel-mocks": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- node --experimental-strip-types scripts/checkBarrelMockCoverage.ts",
        "test:e2e": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended --require-target -- playwright test",
        "test:e2e:full": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended -- playwright test",
        "deliver": "node --experimental-strip-types scripts/deliverPullRequest.ts",
        "lane:open": "node --experimental-strip-types scripts/openLane.ts",
        "lane:publish": "node --experimental-strip-types scripts/publishLane.ts",
        "lane:remove": "node --experimental-strip-types scripts/removeLane.ts",
        "review:prepare": "node --experimental-strip-types scripts/prepareReview.ts",
        "review:publish": "node --experimental-strip-types scripts/publishReview.ts",
        "issue:file": "node --experimental-strip-types scripts/fileTrackerIssue.ts",
        "ipc:parity": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/ipcParity.ts",
        "audio:deadline": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/measureRenderDeadline.ts",
        "transport:clock": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/measureTransportClock.ts",
        "transport:yeast-drift": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/measureYeastGeneratorDrift.ts",
        "test:coverage": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- vitest run --coverage",
        "typecheck": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- tsc --noEmit -p tsconfig.app.json",
        "typecheck:test": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- tsc --noEmit -p tsconfig.test.json",
        "typecheck:scripts": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- tsc --noEmit -p tsconfig.scripts.json",
        "typecheck:e2e": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- tsc --noEmit -p tsconfig.e2e.json",
        "typecheck:electron": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- tsc --noEmit -p electron/tsconfig.json",
        "format": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused --require-target -- prettier --write --",
        "format:full": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- sh -c 'prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\" && cargo fmt --all'",
        "lint": "node --experimental-strip-types scripts/runLint.ts",
        "lint:full": "node --experimental-strip-types scripts/runLint.ts --full",
        "lint:fix": "node --experimental-strip-types scripts/runLint.ts --fix",
        "deps:validate": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node scripts/check-dependency-boundaries.mjs",
        "deps:unused": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- pnpm exec knip",
        "deps:unused:production": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- pnpm exec knip --production",
        "desktop:dev": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended -- sh -c 'install-electron && vite build && tsc -p electron/tsconfig.json && node --experimental-strip-types scripts/buildElectronPreload.ts && SOURDAW_DESKTOP_DEV=1 electron electron/out/main.js 2>&1 | tee electron/out/desktop-dev.log'",
        "desktop:build": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended -- sh -c 'install-electron && vite build && rm -rf dist/samples && tsc -p electron/tsconfig.build.json && node --experimental-strip-types scripts/buildElectronPreload.ts && NODE_OPTIONS=--experimental-strip-types electron-builder --config electron-builder.yml --publish never'",
        "tauri:dev": "tauri dev",
        "tauri:build": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended -- tauri build",
        "cargo:fmt": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused --require-target -- cargo fmt",
        "cargo:test": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused --require-target -- cargo test",
        "cargo:check": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused --require-target -- cargo check",
        "cargo:clippy": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused --require-target -- cargo clippy",
        "cargo:bench": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended --require-target -- cargo bench",
        "cargo:fuzz": "node --experimental-strip-types scripts/resourceGuard.ts --profile extended --require-target -- cargo fuzz",
        "wasm:dsp": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- sh -c 'cd crates/daw-dsp && wasm-pack build --target web --out-dir ../../public/wasm/daw-dsp && rm -f ../../public/wasm/daw-dsp/.gitignore && node --experimental-strip-types ../../scripts/gen-daw-dsp-worklet.ts'",
        "wasm:proof-chamber": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- sh -c 'cd crates/proof-chamber && wasm-pack build --target web --out-dir ../../public/wasm/proof-chamber && rm -f ../../public/wasm/proof-chamber/.gitignore && node --experimental-strip-types ../../scripts/gen-proof-chamber-worklet.ts'",
        "wasm:scoring": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- sh -c 'cd crates/scoring && wasm-pack build --target web --out-dir ../../public/wasm/scoring && rm -f ../../public/wasm/scoring/.gitignore && node --experimental-strip-types ../../scripts/gen-scoring-worklet.ts'",
        "wasm:decoder": "node --experimental-strip-types scripts/resourceGuard.ts --profile broad -- sh -c 'cd crates/daw-wasm-decoder && wasm-pack build --target web --out-dir ../../public/wasm/daw-wasm-decoder --no-typescript && rm -f ../../public/wasm/daw-wasm-decoder/.gitignore && node --experimental-strip-types ../../scripts/gen-wasm-manifest.ts --package daw-wasm-decoder'",
        "wasm:all": "pnpm wasm:dsp && pnpm wasm:proof-chamber && pnpm wasm:scoring && pnpm wasm:decoder && pnpm wasm:manifest",
        "wasm:manifest": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/gen-wasm-manifest.ts",
        "wasm:verify": "node --experimental-strip-types scripts/resourceGuard.ts --profile focused -- node --experimental-strip-types scripts/verify-wasm-artifacts.ts"
    },
    "dependencies": {
        "@automerge/automerge": "^3.3.2",
        "@breezystack/lamejs": "^1.2.7",
        "@grame/faustwasm": "^0.16.5",
        "@mlc-ai/web-llm": "^0.2.84",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@spotify/basic-pitch": "^1.0.1",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-router": "^1.170.18",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fflate": "^0.8.3",
        "lucide-react": "^1.25.0",
        "meyda": "^5.6.3",
        "onnxruntime-web": "^1.27.0",
        "pitchy": "^4.1.0",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.6.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "superjson": "^2.2.6",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@electron/fuses": "^2.1.3",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint-react/eslint-plugin": "^5.17.1",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@tanstack/router-plugin": "^1.168.22",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.10",
        "@webgpu/types": "^0.1.71",
        "babel-plugin-react-compiler": "^1.0.0",
        "dependency-cruiser": "^18.1.0",
        "electron": "43.4.0",
        "electron-builder": "^26.15.3",
        "eslint": "^10.7.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "knip": "^6.27.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.25.0",
        "playwright": "^1.61.1",
        "prettier": "^3.9.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
