{
    "name": "sourdaw",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.6.0",
    "scripts": {
        "dev": "vite",
        "dev:no-hmr": "NO_HMR=1 vite",
        "build": "vite build",
        "prepare": "sh scripts/install-git-hooks.sh",
        "preview": "vite preview",
        "test": "vitest",
        "test:health-gates": "sh scripts/test-health-gate-scripts.sh && sh scripts/test-git-hook-installation.sh",
        "test:run": "vitest run",
        "test:generate-usecase-specs": "node --experimental-strip-types scripts/generate-missing-use-case-specs.ts",
        "test:e2e": "playwright test",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsgo --noEmit",
        "typecheck:test": "tsgo --noEmit -p tsconfig.test.json",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\" && cargo fmt --all",
        "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix \"src/**/*.{ts,tsx}\"",
        "deps:validate": "depcruise src --ignore-known .dependency-cruiser-known-violations.json && depcruise src --config .dependency-cruiser.reachability.cjs --ignore-known .dependency-cruiser-known-violations-reachability.json",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "wasm:dsp": "cd crates/daw-dsp && wasm-pack build --target web --out-dir ../../public/wasm/daw-dsp --no-typescript && rm -f ../../public/wasm/daw-dsp/.gitignore && node --experimental-strip-types ../../scripts/gen-daw-dsp-worklet.ts",
        "wasm:proof-chamber": "cd crates/proof-chamber && wasm-pack build --target web --out-dir ../../public/wasm/proof-chamber --no-typescript && rm -f ../../public/wasm/proof-chamber/.gitignore && node --experimental-strip-types ../../scripts/gen-proof-chamber-worklet.ts",
        "wasm:scoring": "cd crates/scoring && wasm-pack build --target web --out-dir ../../public/wasm/scoring --no-typescript && rm -f ../../public/wasm/scoring/.gitignore && node --experimental-strip-types ../../scripts/gen-scoring-worklet.ts",
        "wasm:decoder": "cd crates/daw-wasm-decoder && wasm-pack build --target web --out-dir ../../public/wasm/daw-wasm-decoder --no-typescript && rm -f ../../public/wasm/daw-wasm-decoder/.gitignore",
        "wasm:all": "npm run wasm:dsp && npm run wasm:proof-chamber && npm run wasm:scoring && npm run wasm:decoder"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.90.0",
        "@automerge/automerge": "^3.2.5",
        "@breezystack/lamejs": "^1.2.7",
        "@grame/faustwasm": "^0.16.1",
        "@mlc-ai/web-llm": "^0.2.82",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@spotify/basic-pitch": "^1.0.1",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/eslint-plugin-query": "^5.99.2",
        "@tanstack/react-query": "^5.99.2",
        "@tanstack/react-router": "^1.168.23",
        "@tauri-apps/api": "^2.10.1",
        "@tauri-apps/plugin-dialog": "^2.7.0",
        "@tauri-apps/plugin-fs": "^2.5.0",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fflate": "^0.8.2",
        "lucide-react": "^1.8.0",
        "meyda": "^5.6.3",
        "onnxruntime-web": "^1.24.3",
        "pitchy": "^4.1.0",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.4.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "superjson": "^2.2.6",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
        "@eslint-react/eslint-plugin": "^4.2.3",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.59.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tanstack/router-plugin": "^1.167.22",
        "@tauri-apps/cli": "^2.10.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jscodeshift": "^17.3.0",
        "@types/node": "^25.6.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript/native-preview": "7.0.0-dev.20260420.1",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.4",
        "@webgpu/types": "^0.1.69",
        "babel-plugin-react-compiler": "^1.0.0",
        "dependency-cruiser": "^17.3.10",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-jsx-a11y-x": "^0.1.1",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^64.0.0",
        "glob": "^13.0.6",
        "globals": "^17.5.0",
        "jscodeshift": "^17.3.0",
        "jsdom": "^29.0.2",
        "knip": "^6.5.0",
        "playwright": "^1.59.1",
        "ts-morph": "^28.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.9",
        "vitest": "^4.1.4"
    }
}
