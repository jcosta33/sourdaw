{
    "name": "sourdaw",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.6.0",
    "scripts": {
        "dev": "vite",
        "dev:no-hmr": "NO_HMR=1 vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:health-gates": "sh scripts/test-health-gate-scripts.sh",
        "test:run": "vitest run",
        "test:collection-scope": "node --experimental-strip-types scripts/checkVitestCollectionScope.ts",
        "test:barrel-mocks": "node --experimental-strip-types scripts/checkBarrelMockCoverage.ts",
        "test:generate-usecase-specs": "node --experimental-strip-types scripts/generate-missing-use-case-specs.ts",
        "test:e2e": "playwright test",
        "verify:change": "node --experimental-strip-types scripts/verifyChange.ts",
        "audio:deadline": "node --experimental-strip-types scripts/measureRenderDeadline.ts",
        "transport:clock": "node --experimental-strip-types scripts/measureTransportClock.ts",
        "transport:yeast-drift": "node --experimental-strip-types scripts/measureYeastGeneratorDrift.ts",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\" && cargo fmt --all",
        "lint": "oxlint src scripts && eslint --cache --cache-location node_modules/.cache/eslint/ \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
        "lint:fix": "oxlint --fix src scripts && eslint --cache --cache-location node_modules/.cache/eslint/ --fix \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
        "layout:census:check": "node --experimental-strip-types scripts/layoutPrimitivesCensus.ts --check",
        "layout:census:generate": "node --experimental-strip-types scripts/layoutPrimitivesCensus.ts --write",
        "deps:validate": "node scripts/check-dependency-boundaries.mjs",
        "deps:baseline:main": "node scripts/check-dependency-boundaries.mjs --write-baseline main",
        "deps:baseline:reachability": "node scripts/check-dependency-boundaries.mjs --write-baseline reachability",
        "deps:baseline:tests": "node scripts/check-dependency-boundaries.mjs --write-baseline tests",
        "deps:baseline:types": "node scripts/check-dependency-boundaries.mjs --write-baseline types",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "wasm:dsp": "cd crates/daw-dsp && wasm-pack build --target web --out-dir ../../public/wasm/daw-dsp && rm -f ../../public/wasm/daw-dsp/.gitignore && node --experimental-strip-types ../../scripts/gen-daw-dsp-worklet.ts",
        "wasm:proof-chamber": "cd crates/proof-chamber && wasm-pack build --target web --out-dir ../../public/wasm/proof-chamber && rm -f ../../public/wasm/proof-chamber/.gitignore && node --experimental-strip-types ../../scripts/gen-proof-chamber-worklet.ts",
        "wasm:scoring": "cd crates/scoring && wasm-pack build --target web --out-dir ../../public/wasm/scoring && rm -f ../../public/wasm/scoring/.gitignore && node --experimental-strip-types ../../scripts/gen-scoring-worklet.ts",
        "wasm:decoder": "cd crates/daw-wasm-decoder && wasm-pack build --target web --out-dir ../../public/wasm/daw-wasm-decoder --no-typescript && rm -f ../../public/wasm/daw-wasm-decoder/.gitignore",
        "wasm:all": "npm run wasm:dsp && npm run wasm:proof-chamber && npm run wasm:scoring && npm run wasm:decoder && npm run wasm:manifest",
        "wasm:manifest": "node --experimental-strip-types scripts/gen-wasm-manifest.ts",
        "wasm:verify": "node --experimental-strip-types scripts/verify-wasm-artifacts.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.112.3",
        "@automerge/automerge": "^3.3.2",
        "@breezystack/lamejs": "^1.2.7",
        "@grame/faustwasm": "^0.16.5",
        "@mlc-ai/web-llm": "^0.2.84",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@spotify/basic-pitch": "^1.0.1",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-router": "^1.170.18",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fflate": "^0.8.3",
        "lucide-react": "^1.25.0",
        "meyda": "^5.6.3",
        "onnxruntime-web": "^1.27.0",
        "pitchy": "^4.1.0",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.6.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "superjson": "^2.2.6",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint-react/eslint-plugin": "^5.17.1",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@tanstack/router-plugin": "^1.168.22",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jscodeshift": "^17.3.0",
        "@types/node": "^26.1.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.10",
        "@webgpu/types": "^0.1.71",
        "babel-plugin-react-compiler": "^1.0.0",
        "dependency-cruiser": "^18.1.0",
        "eslint": "^10.7.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "glob": "^13.0.6",
        "globals": "^17.7.0",
        "jscodeshift": "^17.4.0",
        "jsdom": "^29.1.1",
        "knip": "^6.27.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.25.0",
        "playwright": "^1.61.1",
        "prettier": "^3.9.5",
        "ts-morph": "^28.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
