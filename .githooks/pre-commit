#!/usr/bin/env bash
# Staged conflict markers. Harness-agnostic: every agent and every human runs `git commit`, so this
# is the one content gate that binds Claude, Codex, Kimi, zcode and people equally.
#
# Git refuses to commit a path that is still unmerged, so the only way a marker reaches history is a
# resolution that staged the file as resolved with markers still inside it. Nothing else catches
# that: a formatter rewrites rather than reports, so running it over a half-resolved file reformats
# the markers and exits clean.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Bypass for a genuine exception:  git commit --no-verify

set -uo pipefail

# Only the opening, closing and diff3-base markers, each anchored to column 0 and followed by the
# label git always writes. The separator is deliberately absent: a bare row of `=` at column 0 is a
# setext heading in Markdown, and a check that cries wolf gets turned off. Written inline rather
# than in a heredoc so this file never carries one of these at column 0 itself.
marker_pattern='^(<<<<<<<|\|\|\|\|\|\|\||>>>>>>>) '

paths=()
while IFS= read -r -d '' path; do
  paths+=("$path")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ ${#paths[@]} -eq 0 ]; then
  exit 0
fi

# `git grep --cached` reads the index, so the working tree is never consulted and an unstaged marker
# is not this hook's business. `-I` drops binary blobs.
#
# The paths are never handed to `git grep` as argv: a repo-wide commit's tracked-path total already
# sits within ~1.5x of ARG_MAX, and a pathspec list that overflows it makes `git grep` fail. The old
# code sent that failure's stderr to `/dev/null` and read the resulting empty candidate list as
# "clean" — an argv overflow read as a pass. Scanning the whole cached index instead has no argv
# ceiling, and intersecting the hits with the staged paths below keeps the same "staged files only"
# result. `git grep`'s own exit status is checked directly: 0 is hits, 1 is no hits, anything else is
# an error this hook must not swallow.
#
# `-z` is load-bearing, not cosmetic. Without it `git grep -l` renders a path through
# `core.quotePath`, which defaults to true, so `café.md` prints as `"caf\303\251.md"` while
# `git diff --name-only -z` prints the same file as raw bytes. Intersecting those two spellings
# matched neither, and a file with a real conflict in it dropped out of the scan and committed
# silently. A name is also quoted for reasons `core.quotePath` does not govern at all — an embedded
# `"`, a backslash, or a control character — so turning that config off would have left the hole
# open. `-z` makes both sides emit the same raw bytes, NUL-terminated.
grep_stderr_file="$(mktemp)"
grep_hits_file="$(mktemp)"
git grep --cached -I -l -z -E "$marker_pattern" >"$grep_hits_file" 2>"$grep_stderr_file"
grep_status=$?
grep_stderr="$(cat "$grep_stderr_file")"
rm -f "$grep_stderr_file"

if [ "$grep_status" -gt 1 ]; then
  rm -f "$grep_hits_file"
  printf 'pre-commit: git grep failed while scanning the index for merge-conflict markers (exit %d).\n' \
    "$grep_status" >&2
  if [ -n "$grep_stderr" ]; then
    printf '%s\n' "$grep_stderr" >&2
  fi
  echo '' >&2
  echo 'Refusing rather than passing silently: an unreadable index is not evidence the commit is clean.' >&2
  echo '' >&2
  echo 'Deliberate exception: git commit --no-verify' >&2
  exit 1
fi

# The intersection is taken on NUL-delimited records and never on lines. `comm` has no NUL mode, so
# a `sort`+`comm` pipeline can only compare line-splittable input — which silently splits a path
# containing a literal newline into two rows that match nothing, exactly the class of hole the
# quoting mismatch above belonged to. Reading both sides with `read -d ''` is the only form in which
# every legal filename — non-ASCII, quote-needing, space-bearing, newline-bearing — round-trips
# intact, because NUL is the one byte a path cannot contain.
#
# awk is deliberately not used to do this. macOS ships one-true-awk, where `RS="\0"` truncates the
# separator to the empty string and flips the parser into paragraph mode: `printf 'a\0b\0'` yields a
# single record and every path after the first vanishes. That reads as "nothing staged has markers"
# and is a broader fail-open than the one being repaired here.
#
# The membership test is element-wise rather than hashed because `/usr/bin/env bash` is 3.2 on macOS
# and has no associative arrays, and because no in-band separator exists for a bash string: a path
# may contain a newline, and it cannot contain the NUL that a bash string is itself terminated by.
# The outer loop runs over files that actually carry markers, which is zero on virtually every
# commit and a handful otherwise, so the product never approaches the staged-file count.
candidates=()
if [ "$grep_status" -eq 0 ]; then
  while IFS= read -r -d '' hit; do
    for staged in "${paths[@]}"; do
      if [ "$hit" = "$staged" ]; then
        candidates+=("$hit")
        break
      fi
    done
  done <"$grep_hits_file"
fi
rm -f "$grep_hits_file"

if [ ${#candidates[@]} -eq 0 ]; then
  exit 0
fi

# A fenced code block is where documentation legitimately shows a marker, so Markdown gets that one
# exemption and nothing else. An indented code block needs no rule: indentation already moves the
# marker off column 0.
#
# CommonMark's fence rule is tracked properly rather than toggled on any run of backticks or tildes:
# an opener records which character opened it and how long the run was, and only a run of that same
# character at least as long closes it. A shorter run, or the other character, is content — which is
# exactly the standard way to show a fence nested inside a fence (a longer outer run wrapping a
# shorter inner one). Toggling on any run instead sends `fence` stuck open for the rest of the file
# the moment a nested example appears, and every later marker in ordinary prose goes unseen.
report=''
for path in "${candidates[@]}"; do
  case "$path" in
    *.md|*.mdx) fenced=1 ;;
    *) fenced=0 ;;
  esac
  # The path reaches awk through the environment, never through `-v`. An `-v` assignment is parsed
  # as an awk string literal: a filename holding a newline aborts awk outright with "newline in
  # string", and one holding a backslash has `\s`-style sequences silently expanded into something
  # that is no longer the file's name. The abort was the worse half — awk exited non-zero, `hits`
  # came back empty, and the hook reported a clean commit for a file it had just found markers in.
  # `ENVIRON` carries arbitrary bytes and interprets none of them.
  hits="$(git show ":$path" | marker_path="$path" awk -v fenced="$fenced" '
    BEGIN { path = ENVIRON["marker_path"] }
    function count_run(s, ch,    n) {
      n = 0
      while (n < length(s) && substr(s, n + 1, 1) == ch) n++
      return n
    }
    function leading_spaces(s,    n) {
      n = 0
      while (n < length(s) && substr(s, n + 1, 1) == " ") n++
      return n
    }
    {
      # awk ends a record at "\n" alone, so every line of a CRLF file arrives with a trailing "\r"
      # still attached. That carriage return made a closing fence unrecognizable — the run of
      # backticks was followed by "\r" rather than by nothing, so the fence never closed and every
      # marker from there to end of file was skipped as if it were sample code. CommonMark treats
      # CR, LF and CRLF alike as line endings and strips them before parsing, so removing it here is
      # what the fence rule already assumes. It is stripped once, at the top, rather than at the one
      # comparison that exposed it: the indent count, the delimiter run, the fence-open test and the
      # marker match all read the same record, and patching only the closing test would leave the
      # next reader to rediscover the same assumption.
      sub(/\r$/, "")
      if (fenced) {
        indent = leading_spaces($0)
        rest = substr($0, indent + 1)
        first = substr(rest, 1, 1)
        if (!fence) {
          if (indent <= 3 && (first == "`" || first == "~")) {
            run = count_run(rest, first)
            if (run >= 3) {
              fence = 1
              fence_char = first
              fence_len = run
              next
            }
          }
        } else {
          if (indent <= 3 && first == fence_char) {
            run = count_run(rest, first)
            trailing = substr(rest, run + 1)
            gsub(/[ \t]/, "", trailing)
            if (run >= fence_len && trailing == "") {
              fence = 0
              next
            }
          }
          next
        }
      }
      if ($0 ~ /^(<<<<<<<|\|\|\|\|\|\|\||>>>>>>>) /) {
        printf "  %s:%d: %s\n", path, FNR, $0
      }
    }
  ')"
  # `$(...)` eats the trailing newline, so put one back or two files report as one line.
  [ -n "$hits" ] && report="${report}${hits}"$'\n'
done

if [ -z "$report" ]; then
  exit 0
fi

printf 'pre-commit: staged content still contains merge-conflict markers.\n\n%s\n' "$report" >&2
echo 'Finish the resolution, restage the file, and commit again.' >&2
echo 'A formatter will happily reformat a marker, so it is no evidence the file is resolved.' >&2
echo '' >&2
echo 'Deliberate exception: git commit --no-verify' >&2
exit 1
