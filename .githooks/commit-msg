#!/usr/bin/env bash
# Conventional commit subject. Harness-agnostic: every agent and every human runs `git commit`,
# so this is the one title gate that binds Claude, Codex, Kimi, zcode and people equally.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Bypass for a genuine exception:  git commit --no-verify

set -uo pipefail

msg_file="$1"
subject="$(head -1 "$msg_file")"

# Let git's merge and transient autosquash messages through untouched. Merges never become the
# lane's pull-request title, and fixup!/squash! commits are folded away before publishing. Revert
# and Reapply subjects are not passed: lane:publish titles the pull request from the newest
# non-merge subject, so a type it refuses must be refused here too. The types below are exactly
# LANE_CHANGE_TYPES in scripts/prContract.ts; scripts/__tests__/commitMsgHook.spec.ts pins them.
case "$subject" in
  "Merge "*|"fixup! "*|"squash! "*) exit 0 ;;
  "#"*|"") exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|test|refactor|perf|build|ci)(\([a-z0-9,._/-]+\))?!?: .+'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
  if [ "${#subject}" -gt 100 ]; then
    printf 'commit-msg: subject is %s chars (max 100).\n\n  %s\n\n' "${#subject}" "$subject" >&2
    echo 'Put the detail in the body, one blank line down.' >&2
    exit 1
  fi
  exit 0
fi

cat >&2 <<EOF
commit-msg: subject does not match this repo's convention.

  $subject

Expected  type(scope): subject
Types     feat fix chore docs test refactor perf build ci
Scope     the module or crate — fermenter, proof-chamber, arrangement, infra …

  fix(fermenter): correct the plate tank delays that read a sample short
  feat(proof-chamber): wire the Decay EQ bands to the engines
  test(e2e): cover the recorder arm and overdub flow

Deliberate exception: git commit --no-verify
EOF
exit 1
