{
    // Type-resolution and build project for the Electron main process.
    //
    // It sits at `electron/` for the same reason `scripts/tsconfig.json` does:
    // oxlint's type-aware pass discovers the nearest `tsconfig.json` per file,
    // and the root project covers only `src`.
    //
    // Three differences from the root project, each describing how this code
    // actually executes. It runs in Electron's Node process, so it gets Node's
    // types and no DOM lib — `document` and `window` do not exist here, and the
    // fetch/`Response` globals it does use come from `@types/node`. It is
    // resolved and emitted as real Node ESM (`package.json` declares
    // `"type": "module"`), so relative imports carry the `.js` specifier Node
    // requires at runtime.
    //
    // This project is typecheck-only (`pnpm typecheck:electron`) and the only
    // one that sees the specs. Emit happens through the extending
    // `tsconfig.dev.json` / `tsconfig.build.json`, whose spec-free scope
    // compiles into `electron/out/` (gitignored).
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "lib": ["ES2024"],
        "types": ["node"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        // No alias: the specs cross-check the shell's command table against
        // the renderer's `SOURDAW_COMMAND_ARGUMENTS` through an explicit
        // relative import, and shell runtime code must not touch `src/` at
        // all — `commands.spec.ts` pins that boundary.
        "paths": {}
    },
    "include": ["."],
    "exclude": ["out"]
}
