{
    // Test-inclusive typecheck. The base tsconfig.json (used by `tsgo --noEmit`)
    // excludes *.spec.ts(x), so spec files are never type-checked there. This
    // project re-includes them: same compiler options, repo-wide `src` scope,
    // without the spec exclusion. Run with:
    //   pnpm typecheck:test
    "extends": "./tsconfig.json",
    "include": ["src", "vite-env.d.ts"],
    "exclude": ["dist", "build", "coverage", "storybook-static"]
}
