{
    // Test-inclusive typecheck gate (`pnpm typecheck:test`, native tsc). The
    // base tsconfig.json is spec-inclusive so oxlint's type-aware linting sees
    // real types in tests; the app gate `pnpm typecheck` runs tsconfig.app.json,
    // which re-excludes specs. This project keeps the spec-inclusive scope:
    // same compiler options, repo-wide `src`, no spec exclusion.
    "extends": "./tsconfig.json",
    "include": ["src", "vite-env.d.ts"],
    "exclude": ["dist", "build", "coverage", "storybook-static"]
}
