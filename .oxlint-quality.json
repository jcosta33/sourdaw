{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "vitest"],
    "jsPlugins": ["./scripts/oxlintCraft/plugin.mjs"],
    "categories": {
        "correctness": "off",
        "suspicious": "off",
        "pedantic": "off",
        "perf": "off",
        "style": "off",
        "restriction": "off",
        "nursery": "off"
    },
    "options": {
        "typeAware": true
    },
    "ignorePatterns": [
        "src/routeTree.gen.ts",
        "src/modules/AudioEngine/wasm/*.js",
        "src/modules/AudioEngine/wasm/*.d.ts",
        "src/modules/AudioRendering/workers/vendor/vorbis/ogg-encode.js",
        "src/modules/AudioRendering/workers/vendor/vorbis/ogg-encode.d.ts",
        "src/modules/AudioRendering/workers/vendor/opus/opus-encode.js",
        "src/modules/AudioRendering/workers/vendor/opus/opus-encode.d.ts",
        "src/modules/AudioRendering/workers/vendor/opus/core.js",
        "src/modules/AudioRendering/workers/vendor/vorbis/vorbis.wasm.js",
        "src/modules/AudioRendering/workers/vendor/opus/src/opus.wasm.js",
        "scripts/**/*.mjs",
        "scripts/**/*.cjs",
        "scripts/download-levain-samples-direct.ts",
        "scripts/download-levain-samples.ts",
        "scripts/__tests__/check-dependency-boundaries.spec.ts",
        "scripts/oxlintCraft/__tests__/fixtures/**"
    ],
    "rules": {
        "no-else-return": ["error", { "allowElseIf": true }],
        "typescript/no-unnecessary-type-parameters": "error",
        "typescript/switch-exhaustiveness-check": [
            "error",
            {
                "considerDefaultExhaustiveForUnions": false
            }
        ],
        "sourdaw-craft/no-conditional-empty-spread": "error",
        "sourdaw-craft/no-useless-clone-spread": "error",
        "sourdaw-craft/no-spread-clone-array-method": "error",
        "sourdaw-craft/no-json-parse-stringify": "error",
        "sourdaw-craft/no-long-array-chain": "error",
        "sourdaw-craft/no-control-flow-ternary": "error",
        "sourdaw-craft/no-complex-ternary-branch": "error",
        "sourdaw-craft/no-silent-catch": "error",
        "sourdaw-craft/no-failed-operation-success": "error",
        "sourdaw-craft/no-external-data-assertion": "error"
    },
    "overrides": [
        {
            "files": ["src/**/*.{ts,tsx}"],
            "excludeFiles": [
                "**/*.d.ts",
                "**/*.{spec,test,mock}.{ts,tsx}",
                "**/setupTests.ts",
                "**/__tests__/**",
                "src/**/testing/**"
            ],
            "rules": {
                "complexity": ["error", 12],
                "max-depth": ["error", 4],
                "max-lines-per-function": [
                    "error",
                    { "max": 80, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
                ],
                "max-params": ["error", { "max": 4 }],
                "sourdaw-craft/no-positional-boolean-flags": "error",
                "typescript/no-non-null-assertion": "error"
            }
        },
        {
            "files": [
                "src/modules/{AgentAdapters,CommandInterface,ControlRoom,ControlSurface,FactorySynthesis,Gluten,Levain}/**/*.{ts,tsx}",
                "src/modules/{Metering,ProjectVersioning,Proof,PunchRecording,SessionLauncher,Tuner}/**/*.{ts,tsx}",
                "src/modules/WorkspaceShell/{events,handlers,models,repositories,stores,useCases}/**/*.{ts,tsx}",
                "src/modules/WorkspaceShell/presentations/{helpers,views}/**/*.{ts,tsx}",
                "src/components/{layout,ui}/**/*.{ts,tsx}",
                "src/{helpers,routes}/**/*.{ts,tsx}"
            ],
            "excludeFiles": [
                "**/*.d.ts",
                "**/*.{spec,test,mock}.{ts,tsx}",
                "**/setupTests.ts",
                "**/__tests__/**",
                "src/**/testing/**"
            ],
            "rules": {
                "typescript/no-unsafe-type-assertion": "error"
            }
        },
        {
            "files": ["src/**/*.{spec,test}.{ts,tsx}"],
            "excludeFiles": ["**/*.e2e.spec.*"],
            "rules": {
                "vitest/expect-expect": "error"
            }
        },
        {
            "files": ["**/*.{spec,test}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}"],
            "excludeFiles": ["**/*.e2e.spec.*", "tests/e2e/**", "server/**", "electron/out/**"],
            "rules": {
                "vitest/no-conditional-expect": "error",
                "sourdaw-craft/no-invalid-vitest-expect": "error"
            }
        },
        {
            "files": ["tests/e2e/**/*.{spec,test}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}"],
            "rules": {
                "sourdaw-craft/no-conditional-playwright-admission": "error"
            }
        },
        {
            "files": [
                "**/*.{spec,test}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
                "**/__tests__/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
                "src/**/testing/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
                "tests/e2e/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}"
            ],
            "rules": {
                "sourdaw-craft/no-fixed-test-sleep": "error"
            }
        }
    ]
}
