{
    // Base project for editor tooling and oxlint's type-aware linting
    // (tsgolint discovers `tsconfig.json` per file). It is spec-inclusive so
    // that type-aware lint rules receive real types in test files.
    // `pnpm typecheck` (app gate) uses tsconfig.app.json, which re-excludes
    // specs — the app typecheck scope is unchanged.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["@webgpu/types"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "include": ["src", "vite-env.d.ts"],
    "exclude": ["dist", "build", "coverage", "storybook-static"]
}
