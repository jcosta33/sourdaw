{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/app/main.tsx", "src/routes/**/*.tsx"],
  "project": ["src/**/*.{ts,tsx}", "!src/**/*.spec.{ts,tsx}", "!src/**/*.test.{ts,tsx}"],
  "ignore": [
    "src/routeTree.gen.ts",
    "src/helpers/DependencyInjector/inject.ts",
    "src/helpers/Store/ReadonlyStore.ts",
    "src/helpers/DOM/KeyPressNotifier.ts",
    "src/helpers/Event/createEventBus.ts",
    "src/helpers/Event/EventLog.ts",
    "src/helpers/Event/DevToolsEventBus.ts",
    "src/helpers/Event/eventLogHelpers.ts",
    "src/helpers/Logger/createLogger.ts",
    "src/helpers/React/useKeyPressNotifier.ts",
    "src/helpers/React/slots/slots.ts",
    "src/helpers/Styles/merge.ts",
    "src/helpers/UI/getKeyWithModifier.ts"
  ],
  "ignoreDependencies": [
    "@tailwindcss/vite",
    "babel-plugin-react-compiler",
    "@tanstack/router-plugin"
  ]
}
