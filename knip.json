{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/routes/**/*.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.spec.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/routeTree.gen.ts"
  ],
  "ignore": [
    "src/components/ui/dialog.tsx"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@tauri-apps/plugin-fs",
    "tailwindcss"
  ],
  "ignoreBinaries": [
    "prettier"
  ]
}
